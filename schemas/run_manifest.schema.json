{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdid.github.io/social/schemas/run_manifest.schema.json",
  "title": "Social RunManifest v1",
  "type": "object",
  "required": ["schema_version", "run_id", "incident_id", "state", "started_at_utc", "producer", "git_commit", "policy_version", "source_snapshots", "task_receipts", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["created", "collecting", "normalized", "extracting", "verifying", "reconstructing", "reporting", "completed_bounded", "failed_with_receipt"]},
    "started_at_utc": {"$ref": "common.schema.json#/$defs/utcDateTime"},
    "finished_at_utc": {"anyOf": [{"$ref": "common.schema.json#/$defs/utcDateTime"}, {"type": "null"}]},
    "producer": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "model_config": {"type": "object"},
    "source_snapshots": {"type": "array", "items": {"type": "object", "required": ["snapshot_id", "sha256", "access_status"], "properties": {"snapshot_id": {"type": "string"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "access_status": {"enum": ["complete", "partial", "blocked", "not_found", "failed"]}, "platform": {"type": ["string", "null"]}, "fetched_at_utc": {"$ref": "common.schema.json#/$defs/utcDateTime"}, "snapshot_artifact_path": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "task_receipts": {"type": "array", "items": {"type": "object", "required": ["task_id", "status", "attempted_at_utc"], "properties": {"task_id": {"type": "string"}, "status": {"enum": ["complete", "partial", "blocked", "not_found", "failed"]}, "attempted_at_utc": {"$ref": "common.schema.json#/$defs/utcDateTime"}, "detail_ref": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}, "additionalProperties": false}},
    "limitations": {"$ref": "common.schema.json#/$defs/limitations"}
  },
  "additionalProperties": false
}
